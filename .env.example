# Copia este archivo como .env y completa los valores privados.
ADMIN_EMAIL=tu-correo-de-admin@example.com
ADMIN_PASSWORD=elige-una-contrasena-larga-y-unica
SESSION_SECRET=genera-una-clave-aleatoria-larga

# Gmail: activa la verificación en dos pasos y crea una contraseña de aplicación.
# No uses tu contraseña normal de Gmail ni subas el .env a GitHub.
SMTP_USER=tu-correo@gmail.com
SMTP_APP_PASSWORD=clave-de-aplicacion-de-16-caracteres
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Supabase sigue atendiendo inicio de sesión, finanzas y actividad mientras migramos esos módulos.
SUPABASE_URL=https://kwqoowouazoqmneejuxz.supabase.co
SUPABASE_PRODUCTS_BUCKET=product-images
SUPABASE_SERVICE_ROLE_KEY=PEGA_AQUI_LA_CLAVE_PRIVADA_SOLO_EN_EL_SERVIDOR

# Appwrite: catálogo de productos e imágenes. El endpoint depende de la región del proyecto.
APPWRITE_ENDPOINT=https://sfo.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6afbf48e003dc6106784
APPWRITE_DATABASE_ID=6afc0156001d3dd77b2e
APPWRITE_PRODUCTS_TABLE_ID=6afc017900116468e591
APPWRITE_PRODUCTS_BUCKET_ID=6afc6a210013e1e1daad
